{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "args": ["-f", "Makefile.txt"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "dependsOn":["clean"],
            "dependsOrder": "sequence"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make",
            "args": ["-f", "Makefile.txt", "clean"],
            "problemMatcher": [],
            "group": "none"
        }
    ]
}